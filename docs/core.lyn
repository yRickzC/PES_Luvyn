namespace luvyn

module Compiler

purpose:
    compilar fontes .lyn em documentação semântica consultável

depends:
    Parser
    Resolver
    GraphEngine
    BinaryArtifact

rules:
    - falha de validação preserva o último artefato válido
    - recompilar somente documentos cujo hash mudou

exposes:
    build(workspace: String) -> BinaryArtifact

source:
    crates/luvyn-core/src/workspace.rs

component Parser

purpose:
    reconhecer declarações, seções, assinaturas e referências sem executar código

rules:
    - diagnostics incluem arquivo, linha, coluna e sugestão
    - fonte inválida produz diagnostics sem panic
    - indentação usa espaços

exposes:
    parse(path: String, text: String) -> GraphEngine

source:
    crates/luvyn-core/src/parser.rs

component Resolver

purpose:
    resolver símbolos locais, imports explícitos e nomes qualificados

depends:
    Parser

rules:
    - namespaces diferentes exigem import ou nome qualificado
    - nomes ambíguos nunca são escolhidos automaticamente
    - IDs derivam do namespace, nome e kind; localização não altera identidade

source:
    crates/luvyn-core/src/resolver.rs

system GraphEngine

purpose:
    recuperar apenas símbolos e relações relevantes para uma consulta

depends:
    Resolver

behavior:
    interpretar consultas locais, atravessar relações com limite de profundidade e respeitar orçamento de contexto

rules:
    - ciclos terminam por conjunto de nodes visitados
    - consultas não dependem de LLM externo
    - índices incluem nomes, termos, relações diretas e reversas

exposes:
    query(text: String, depth: Int) -> String

source:
    crates/luvyn-core/src/query.rs

struct BinaryArtifact

purpose:
    persistir grafo versionado com registros de nodes acessíveis individualmente

rules:
    - magic LUVYN identifica o formato
    - checksums validam diretório e cada node
    - versão ou limites inválidos retornam erro estruturado
    - payload usa postcard binário; não JSON

source:
    crates/luvyn-core/src/binary.rs
